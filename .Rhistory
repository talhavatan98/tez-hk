# Ortak örnekleri bul
common_samples <- Reduce(intersect, list(
names(Y_outcome),
rownames(X_mrna),
rownames(X_meth)
))
cat("Ortak örnek sayısı:", length(common_samples), "\n\n")
# Verileri hizala
Y_outcome <- Y_outcome[common_samples]
X_mrna <- X_mrna[common_samples, ]
X_meth <- X_meth[common_samples, ]
# X listesi
X_data <- list(
mRNA = X_mrna,
Methylation = X_meth
)
# Sınıf bilgisi
cat("Sınıf Dağılımı:", paste(names(table(Y_outcome)), "=", table(Y_outcome), collapse=", "), "\n")
cat(sprintf("Dengesizlik: %.2f:1\n\n", max(table(Y_outcome))/min(table(Y_outcome))))
# TRAIN/TEST SPLIT --------------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   TRAIN/TEST SPLIT (%30 TEST)          ║\n")
cat("╚════════════════════════════════════════╝\n\n")
set.seed(123)
train_idx <- createDataPartition(Y_outcome, p = 1 - config$test_size, list = FALSE)[,1]
test_idx <- setdiff(1:length(Y_outcome), train_idx)
# Train
Y_train <- Y_outcome[train_idx]
X_train <- list(
mRNA = X_data$mRNA[train_idx, ],
Methylation = X_data$Methylation[train_idx, ]
)
# Test
Y_test <- Y_outcome[test_idx]
X_test <- list(
mRNA = X_data$mRNA[test_idx, ],
Methylation = X_data$Methylation[test_idx, ]
)
cat(sprintf("Train: %d (Mutant=%d, WT=%d)\n",
length(Y_train), sum(Y_train=="Mutant"), sum(Y_train=="WT")))
cat(sprintf("Test:  %d (Mutant=%d, WT=%d)\n\n",
length(Y_test), sum(Y_test=="Mutant"), sum(Y_test=="WT")))
# DESIGN MATRIX -----------------------------------------------------------
design <- matrix(config$design_value,
ncol = length(X_train),
nrow = length(X_train),
dimnames = list(names(X_train), names(X_train)))
diag(design) <- 0
# 1. OPTIMAL KOMPONENT SAYISI ---------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   1. OPTIMAL KOMPONENT SAYISI          ║\n")
cat("╚════════════════════════════════════════╝\n\n")
set.seed(123)
initial_model <- block.splsda(
X = X_train,
Y = Y_train,
ncomp = config$max_ncomp,
design = design,
scale = TRUE
)
cat("✓ İlk model kuruldu\n\n")
# CV
set.seed(123)
cat("⏳ Cross-validation (", config$cv_folds, "folds x", config$cv_repeats, "repeats)...\n")
perf_ncomp <- perf(
initial_model,
validation = "Mfold",
folds = config$cv_folds,
nrepeat = config$cv_repeats,
progressBar = TRUE
)
cat("\n")
# Optimal ncomp - KONSERVATIF
optimal_ncomp <- perf_ncomp$choice.ncomp$WeightedVote["Overall.BER", "centroids.dist"]
if(is.na(optimal_ncomp) || optimal_ncomp < 1) {
optimal_ncomp <- 2
cat("⚠️ Optimal ncomp bulunamadı, varsayılan: 2\n")
} else {
# Maksimum 2 ile sınırla (overfitting önlemi)
optimal_ncomp <- min(optimal_ncomp, 2)
cat(sprintf("★ Optimal Komponent: %d (max 2 ile sınırlandırıldı)\n", optimal_ncomp))
}
cat("\n")
# Grafik
pdf(file.path(config$output_dir, "01_Component_Selection.pdf"), width = 12, height = 6)
plot(perf_ncomp, overlay = "measure", sd = TRUE)
dev.off()
# 2. FEATURE SELECTION (keepX) --------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   2. FEATURE SELECTION (KONSERVATIF)   ║\n")
cat("╚════════════════════════════════════════╝\n\n")
test_keepX <- list(
mRNA = config$keepX_mrna,
Methylation = config$keepX_meth
)
cat("keepX aralıkları:\n")
cat("  mRNA:      ", paste(test_keepX$mRNA, collapse=", "), "\n")
cat("  Methylation:", paste(test_keepX$Methylation, collapse=", "), "\n\n")
cat("⏳ Tuning (bu sürebilir)...\n")
set.seed(123)
tune_result <- tune.block.splsda(
X = X_train,
Y = Y_train,
ncomp = optimal_ncomp,
test.keepX = test_keepX,
design = design,
validation = "Mfold",
folds = config$cv_folds,
nrepeat = 10,  # Artırıldı
dist = "centroids.dist",
scale = TRUE,
progressBar = TRUE
)
best_keepX <- tune_result$choice.keepX
cat("\n\n★ Optimal keepX:\n")
for(i in 1:optimal_ncomp) {
cat(sprintf("  Comp %d: mRNA=%d, Meth=%d\n", i, best_keepX$mRNA[i], best_keepX$Methylation[i]))
}
cat("\n")
# Grafik
pdf(file.path(config$output_dir, "02_KeepX_Tuning.pdf"), width = 14, height = 8)
plot(tune_result)
dev.off()
# 3. FİNAL MODEL ----------------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   3. FİNAL MODEL                       ║\n")
cat("╚════════════════════════════════════════╝\n\n")
set.seed(123)
final_model <- block.splsda(
X = X_train,
Y = Y_train,
ncomp = optimal_ncomp,
keepX = best_keepX,
design = design,
scale = TRUE
)
cat("✓ Final model kuruldu\n\n")
# Seçilen özellikler
cat("Seçilen Özellik Sayıları:\n")
for(comp in 1:optimal_ncomp) {
mrna_sel <- selectVar(final_model, comp = comp, block = "mRNA")
meth_sel <- selectVar(final_model, comp = comp, block = "Methylation")
cat(sprintf("  Comp %d: mRNA=%d, Meth=%d\n",
comp, nrow(mrna_sel$mRNA$value), nrow(meth_sel$Methylation$value)))
}
cat("\n")
# 4. TRAIN PERFORMANS (CV) ------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   4. TRAIN SET CV PERFORMANS           ║\n")
cat("╚════════════════════════════════════════╝\n\n")
set.seed(123)
cat("⏳ Cross-validation...\n")
final_perf <- perf(
final_model,
validation = "Mfold",
folds = config$cv_folds,
nrepeat = config$cv_repeats,
dist = "centroids.dist",
progressBar = TRUE
)
cat("\n✓ CV tamamlandı\n\n")
# 5. TEST SET PERFORMANS --------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   5. TEST SET PERFORMANS (UNSEEN)      ║\n")
cat("╚════════════════════════════════════════╝\n\n")
# Tahminler
test_predict <- predict(final_model, X_test)
test_classes <- test_predict$WeightedVote$centroids.dist[, optimal_ncomp]
# Confusion Matrix
conf_mat <- confusionMatrix(
data = factor(test_classes, levels = levels(Y_test)),
reference = factor(Y_test, levels = levels(Y_test)),
positive = "Mutant"
)
cat("Confusion Matrix:\n")
print(conf_mat$table)
cat("\n")
# Metrikler
balanced_acc <- conf_mat$byClass["Balanced Accuracy"]
sensitivity <- conf_mat$byClass["Sensitivity"]
specificity <- conf_mat$byClass["Specificity"]
precision <- conf_mat$byClass["Precision"]
recall <- conf_mat$byClass["Recall"]
f1 <- conf_mat$byClass["F1"]
# MCC
TP <- conf_mat$table["Mutant", "Mutant"]
TN <- conf_mat$table["WT", "WT"]
FP <- conf_mat$table["Mutant", "WT"]
FN <- conf_mat$table["WT", "Mutant"]
mcc <- (TP*TN - FP*FN) / sqrt((TP+FP) * (TP+FN) * (TN+FP) * (TN+FN))
cat("═══════════════════════════════════\n")
cat("   TEST SET PERFORMANS METRİKLERİ\n")
cat("═══════════════════════════════════\n")
cat(sprintf("Balanced Accuracy:  %.3f\n", balanced_acc))
cat(sprintf("Sensitivity:        %.3f\n", sensitivity))
cat(sprintf("Specificity:        %.3f\n", specificity))
cat(sprintf("Precision:          %.3f\n", precision))
cat(sprintf("Recall:             %.3f\n", recall))
cat(sprintf("F1-Score:           %.3f\n", f1))
cat(sprintf("MCC:                %.3f\n", mcc))
cat("═══════════════════════════════════\n\n")
# ROC ve AUC
test_scores <- test_predict$predict$Methylation[, "Mutant", optimal_ncomp]
roc_obj <- roc(
response = Y_test,
predictor = test_scores,
levels = c("WT", "Mutant"),
direction = "<"
)
auc_value <- as.numeric(auc(roc_obj))
ci_auc <- ci.auc(roc_obj)
cat(sprintf("ROC AUC:   %.3f [%.3f - %.3f]\n", auc_value, ci_auc[1], ci_auc[3]))
# PR-AUC
binary_labels <- ifelse(Y_test == "Mutant", 1, 0)
pr_obj <- pr.curve(
scores.class0 = test_scores[binary_labels == 1],
scores.class1 = test_scores[binary_labels == 0],
curve = TRUE
)
pr_auc <- pr_obj$auc.integral
cat(sprintf("PR-AUC:    %.3f\n\n", pr_auc))
# Grafik
pdf(file.path(config$output_dir, "03_ROC_PR_Curves.pdf"), width = 14, height = 7)
par(mfrow = c(1, 2), mar = c(5, 5, 4, 2))
plot(roc_obj,
main = sprintf("ROC Curve\nAUC = %.3f [%.3f-%.3f]", auc_value, ci_auc[1], ci_auc[3]),
col = "#E63946", lwd = 3,
xlab = "False Positive Rate",
ylab = "True Positive Rate",
cex.main = 1.3, cex.lab = 1.2)
abline(a = 0, b = 1, lty = 2, col = "gray50", lwd = 2)
grid()
plot(pr_obj,
main = sprintf("Precision-Recall\nAUC = %.3f", pr_auc),
col = "#457B9D", lwd = 3,
auc.main = FALSE, cex.main = 1.3)
grid()
dev.off()
cat("✓ Grafik: 03_ROC_PR_Curves.pdf\n\n")
# 6. PERMUTATION TEST -----------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   6. PERMUTATION TEST                  ║\n")
cat("╚════════════════════════════════════════╝\n\n")
cat(sprintf("⏳ %d permütasyon...\n", config$n_permutations))
set.seed(42)
perm_aucs <- numeric(config$n_permutations)
pb <- txtProgressBar(min = 0, max = config$n_permutations, style = 3)
for(i in 1:config$n_permutations) {
Y_shuffled <- sample(Y_train)
suppressWarnings({
perm_model <- block.splsda(
X = X_train, Y = Y_shuffled,
ncomp = optimal_ncomp, keepX = best_keepX,
design = design, scale = TRUE
)
})
perm_pred <- predict(perm_model, X_test)
perm_scores <- perm_pred$predict$Methylation[, "Mutant", optimal_ncomp]
perm_roc <- suppressMessages(
roc(Y_test, perm_scores, levels = c("WT", "Mutant"), direction = "<", quiet = TRUE)
)
perm_aucs[i] <- as.numeric(auc(perm_roc))
setTxtProgressBar(pb, i)
}
close(pb)
perm_pvalue <- mean(perm_aucs >= auc_value)
cat("\n\n--- PERMUTATION TEST ---\n")
cat(sprintf("Gerçek AUC:     %.3f\n", auc_value))
cat(sprintf("Ort. Perm AUC:  %.3f ± %.3f\n", mean(perm_aucs), sd(perm_aucs)))
cat(sprintf("Max Perm AUC:   %.3f\n", max(perm_aucs)))
cat(sprintf("P-değeri:       %.4f\n", perm_pvalue))
if(perm_pvalue < 0.01) {
cat("\n✅ Model çok anlamlı (p<0.01)\n\n")
} else if(perm_pvalue < 0.05) {
cat("\n✅ Model anlamlı (p<0.05)\n\n")
} else {
cat("\n⚠️ UYARI: Overfitting riski!\n\n")
}
# Grafik
pdf(file.path(config$output_dir, "04_Permutation_Test.pdf"), width = 10, height = 7)
par(mar = c(5, 5, 4, 2))
hist(perm_aucs, breaks = 30, col = "#A8DADC", border = "white",
main = "Permutation Test", xlab = "Permuted AUC", ylab = "Frekans",
xlim = c(0, 1), cex.main = 1.4, cex.lab = 1.2)
abline(v = auc_value, col = "#E63946", lwd = 3, lty = 2)
abline(v = mean(perm_aucs), col = "#457B9D", lwd = 2, lty = 3)
legend("topright",
legend = c(sprintf("Gerçek AUC = %.3f", auc_value),
sprintf("Ort. Perm = %.3f", mean(perm_aucs)),
sprintf("P = %.4f", perm_pvalue)),
col = c("#E63946", "#457B9D", "black"),
lty = c(2, 3, 0), lwd = c(3, 2, 0), cex = 1.1, bg = "white")
grid()
dev.off()
cat("✓ Grafik: 04_Permutation_Test.pdf\n\n")
# 7. SEÇİLEN ÖZELLİKLER ---------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   7. SEÇİLEN ÖZELLİKLER                ║\n")
cat("╚════════════════════════════════════════╝\n\n")
# mRNA
mrna_features <- list()
for(comp in 1:optimal_ncomp) {
selected <- selectVar(final_model, comp = comp, block = "mRNA")
if(nrow(selected$mRNA$value) > 0) {
mrna_features[[comp]] <- data.frame(
Feature = rownames(selected$mRNA$value),
Loading = selected$mRNA$value$value.var,
Component = comp,
stringsAsFactors = FALSE
)
}
}
if(length(mrna_features) > 0) {
mrna_all <- do.call(rbind, mrna_features)
mrna_all <- mrna_all[order(abs(mrna_all$Loading), decreasing = TRUE), ]
cat(sprintf("✓ %d mRNA geni seçildi\n\n", nrow(mrna_all)))
cat("Top 20 mRNA:\n")
print(head(mrna_all, 20))
cat("\n")
write.csv(mrna_all,
file.path(config$output_dir, "Selected_mRNA_Features.csv"),
row.names = FALSE)
}
# Methylation
meth_features <- list()
for(comp in 1:optimal_ncomp) {
selected <- selectVar(final_model, comp = comp, block = "Methylation")
if(nrow(selected$Methylation$value) > 0) {
meth_features[[comp]] <- data.frame(
Feature = rownames(selected$Methylation$value),
Loading = selected$Methylation$value$value.var,
Component = comp,
stringsAsFactors = FALSE
)
}
}
if(length(meth_features) > 0) {
meth_all <- do.call(rbind, meth_features)
meth_all <- meth_all[order(abs(meth_all$Loading), decreasing = TRUE), ]
cat(sprintf("✓ %d Methylation CpG seçildi\n\n", nrow(meth_all)))
cat("Top 20 Methylation:\n")
print(head(meth_all, 20))
cat("\n")
write.csv(meth_all,
file.path(config$output_dir, "Selected_Methylation_Features.csv"),
row.names = FALSE)
}
# 8. VİZUALİZASYONLAR -----------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   8. VİZUALİZASYONLAR                  ║\n")
cat("╚════════════════════════════════════════╝\n\n")
pdf(file.path(config$output_dir, "05_Sample_Plot.pdf"), width = 12, height = 10)
plotIndiv(final_model, ind.names = FALSE, legend = TRUE,
title = "Sample Plot", ellipse = TRUE, style = "ggplot2")
dev.off()
pdf(file.path(config$output_dir, "06_Variable_Plot.pdf"), width = 12, height = 10)
plotVar(final_model, cutoff = 0.7, title = "Variable Correlation", style = "ggplot2")
dev.off()
pdf(file.path(config$output_dir, "07_Circos_Plot.pdf"), width = 12, height = 12)
circosPlot(final_model, cutoff = 0.7, size.variables = 0.6, comp = 1:optimal_ncomp)
dev.off()
pdf(file.path(config$output_dir, "08_CIM_Heatmap.pdf"), width = 14, height = 12)
suppressMessages(
cimDiablo(final_model, color.blocks = c("darkorange", "steelblue"),
comp = 1:optimal_ncomp, margin = c(10, 6))
)
dev.off()
pdf(file.path(config$output_dir, "09_Loadings.pdf"), width = 14, height = 10)
plotLoadings(final_model, comp = 1, contrib = "max", method = "mean",
title = "Loadings - Component 1")
dev.off()
cat("✓ Tüm grafikler kaydedildi\n\n")
# 9. SONUÇLARI KAYDET -----------------------------------------------------
cat("╔════════════════════════════════════════╗\n")
cat("║   9. SONUÇLARI KAYDET                  ║\n")
cat("╚════════════════════════════════════════╝\n\n")
# Performance summary
performance_df <- data.frame(
Metric = c("Balanced Accuracy", "Sensitivity", "Specificity",
"Precision", "Recall", "F1-Score", "MCC",
"ROC AUC", "PR-AUC", "Permutation P-value"),
Value = c(balanced_acc, sensitivity, specificity,
precision, recall, f1, mcc,
auc_value, pr_auc, perm_pvalue),
CI_Lower = c(rep(NA, 7), ci_auc[1], NA, NA),
CI_Upper = c(rep(NA, 7), ci_auc[3], NA, NA)
)
write.csv(performance_df,
file.path(config$output_dir, "Performance_Summary.csv"),
row.names = FALSE)
# Model kaydet
save(
final_model, final_perf, best_keepX, optimal_ncomp,
conf_mat, roc_obj, performance_df, mrna_all, meth_all,
perm_aucs, sex_genes_present,
file = file.path(config$output_dir, "Final_Model.RData")
)
cat("✓ Tüm dosyalar kaydedildi\n\n")
# FİNAL RAPOR -------------------------------------------------------------
cat("\n")
cat("╔══════════════════════════════════════════════════════════════╗\n")
cat("║                                                              ║\n")
cat("║         DIABLO ANALİZ - FİNAL RAPOR                          ║\n")
cat("║         (Cinsiyet Confounder Çıkarılmış)                     ║\n")
cat("║                                                              ║\n")
cat("╚══════════════════════════════════════════════════════════════╝\n\n")
cat("┌──────────────────────────────────────────────────────────────┐\n")
cat("│ CONFOUNDER KONTROLÜ                                          │\n")
cat("├──────────────────────────────────────────────────────────────┤\n")
cat(sprintf("│ Çıkarılan cinsiyet genleri: %d                          \n", length(sex_genes_present)))
cat("│ - Y kromozomu genleri çıkarıldı                             │\n")
cat("│ - X inaktivasyonu genleri çıkarıldı                         │\n")
cat("│ - Model artık gerçek biyolojik sinyali öğreniyor            │\n")
cat("└──────────────────────────────────────────────────────────────┘\n\n")
cat("┌──────────────────────────────────────────────────────────────┐\n")
cat("│ VERİ ÖZETİ                                                   │\n")
cat("├──────────────────────────────────────────────────────────────┤\n")
cat(sprintf("│ Toplam Örnek:     %d                                    \n", length(Y_outcome)))
cat(sprintf("│ Train:            %d (Mutant=%d, WT=%d)                 \n",
length(Y_train), sum(Y_train=="Mutant"), sum(Y_train=="WT")))
cat(sprintf("│ Test:             %d (Mutant=%d, WT=%d)                 \n",
length(Y_test), sum(Y_test=="Mutant"), sum(Y_test=="WT")))
cat(sprintf("│ mRNA Genler:      %d (cinsiyet genleri hariç)           \n", ncol(X_data$mRNA)))
cat(sprintf("│ Methylation CpG:  %d                                    \n", ncol(X_data$Methylation)))
cat("└──────────────────────────────────────────────────────────────┘\n\n")
cat("┌──────────────────────────────────────────────────────────────┐\n")
cat("│ MODEL PARAMETRELERİ (KONSERVATIF)                           │\n")
cat("├──────────────────────────────────────────────────────────────┤\n")
cat(sprintf("│ Komponent:        %d (maksimum 2 ile sınırlandı)        \n", optimal_ncomp))
cat(sprintf("│ mRNA keepX:       %s                                    \n",
paste(best_keepX$mRNA, collapse=", ")))
cat(sprintf("│ Meth keepX:       %s                                    \n",
paste(best_keepX$Methylation, collapse=", ")))
cat("│ Test set:         30% (daha büyük)                           │\n")
cat("│ CV:               5-fold x 20 repeats                        │\n")
cat("└──────────────────────────────────────────────────────────────┘\n\n")
cat("┌──────────────────────────────────────────────────────────────┐\n")
cat("│ TEST SET PERFORMANSI                                         │\n")
cat("├──────────────────────────────────────────────────────────────┤\n")
cat(sprintf("│ ★ Balanced Accuracy:  %.3f                             \n", balanced_acc))
cat(sprintf("│   Sensitivity:        %.3f                             \n", sensitivity))
cat(sprintf("│   Specificity:        %.3f                             \n", specificity))
cat(sprintf("│   F1-Score:           %.3f                             \n", f1))
cat(sprintf("│   MCC:                %.3f                             \n", mcc))
cat("│                                                              │\n")
cat(sprintf("│ ★ ROC AUC:            %.3f [%.3f-%.3f]                 \n",
auc_value, ci_auc[1], ci_auc[3]))
cat(sprintf("│ ★ PR-AUC:             %.3f                             \n", pr_auc))
cat("└──────────────────────────────────────────────────────────────┘\n\n")
cat("┌──────────────────────────────────────────────────────────────┐\n")
cat("│ OVERFİTTİNG KONTROLÜ                                         │\n")
cat("├──────────────────────────────────────────────────────────────┤\n")
cat(sprintf("│ Permutation:     %d iterasyon                           \n", config$n_permutations))
cat(sprintf("│ Gerçek AUC:      %.3f                                   \n", auc_value))
cat(sprintf("│ Ort. Perm AUC:   %.3f ± %.3f                            \n", mean(perm_aucs), sd(perm_aucs)))
cat(sprintf("│ P-değeri:        %.4f                                   \n", perm_pvalue))
cat(sprintf("│ Sonuç:           %s                                     \n",
ifelse(perm_pvalue < 0.05, "✅ Model geçerli", "⚠️ Overfitting")))
cat("└──────────────────────────────────────────────────────────────┘\n\n")
cat("┌──────────────────────────────────────────────────────────────┐\n")
cat("│ SEÇİLEN ÖZELLİKLER                                           │\n")
cat("├──────────────────────────────────────────────────────────────┤\n")
if(exists("mrna_all")) {
cat(sprintf("│ mRNA:            %d gen                                 \n", nrow(mrna_all)))
cat("│   Top 5:                                                     │\n")
for(i in 1:min(5, nrow(mrna_all))) {
gene <- substr(mrna_all$Feature[i], 1, 45)
cat(sprintf("│     %d. %-45s            \n", i, gene))
}
}
cat("│                                                              │\n")
if(exists("meth_all")) {
cat(sprintf("│ Methylation:     %d CpG                                 \n", nrow(meth_all)))
}
cat("└──────────────────────────────────────────────────────────────┘\n\n")
# Sonuç değerlendirmesi
cat("╔══════════════════════════════════════════════════════════════╗\n")
cat("║                    SONUÇ DEĞERLENDİRMESİ                     ║\n")
cat("╠══════════════════════════════════════════════════════════════╣\n")
if(perm_pvalue < 0.05 && auc_value >= 0.7 && auc_value <= 0.95) {
cat("║                                                              ║\n")
cat("║              ✅✅✅ ANALİZ BAŞARILI ✅✅✅                     ║\n")
cat("║                                                              ║\n")
cat("║  • Cinsiyet confounder'ı başarıyla çıkarıldı                ║\n")
cat("║  • Overfitting yok (permutation test anlamlı)               ║\n")
cat("║  • AUC gerçekçi aralıkta (0.70-0.95)                        ║\n")
cat("║  • Model yayınlanabilir!                                    ║\n")
cat("║                                                              ║\n")
} else if(auc_value > 0.95) {
cat("║                                                              ║\n")
cat("║              ⚠️⚠️⚠️ UYARI ⚠️⚠️⚠️                            ║\n")
cat("║                                                              ║\n")
cat("║  • AUC çok yüksek (>0.95) - hala overfitting olabilir       ║\n")
cat("║  • Seçilen genleri manuel kontrol edin                      ║\n")
cat("║  • Başka confounder olabilir                                ║\n")
cat("║                                                              ║\n")
} else {
cat("║                                                              ║\n")
cat("║              📊 SONUÇLAR KABUL EDİLEBİLİR                    ║\n")
cat("║                                                              ║\n")
cat("║  • Model çalışıyor ama iyileştirme yapılabilir              ║\n")
cat("║  • Daha fazla örnek toplayın                                ║\n")
cat("║                                                              ║\n")
}
cat("╚══════════════════════════════════════════════════════════════╝\n\n")
cat(sprintf("📁 Tüm sonuçlar: %s\n\n", config$output_dir))
cat("════════════════════════════════════════════════════════════════\n")
cat("              ANALİZ TAMAMLANDI!                                \n")
cat("════════════════════════════════════════════════════════════════\n\n")
